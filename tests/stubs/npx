#!/bin/sh
# Fake npx: `npx -y skills add <repo> ... -s <skill>` creates ~/.claude/skills/<skill>,
# `npx -y playwright install` creates Playwright's browser cache.
echo "npx $*" >> "$STUB_LOG"
if [ "$*" = "-y playwright install" ]; then
  mkdir -p "$HOME/Library/Caches/ms-playwright/chromium-1000"
  exit 0
fi
skill=""
while [ $# -gt 0 ]; do [ "$1" = -s ] && skill="$2"; shift; done
[ -n "$skill" ] || { echo "npx stub: no -s <skill>" >&2; exit 1; }
mkdir -p "$HOME/.claude/skills/$skill"
echo "# $skill (stub)" > "$HOME/.claude/skills/$skill/SKILL.md"
